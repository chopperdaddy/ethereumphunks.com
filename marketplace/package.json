{
  "name": "etherphunks-market",
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start:sepolia": "vite --mode dev-sepolia",
    "start:mainnet": "vite --mode dev-mainnet",
    "preview": "vite preview",
    "build": "yarn build:sepolia && yarn build:mainnet",
    "build:sepolia": "vite build --mode sepolia",
    "build:mainnet": "vite build --mode mainnet",
    "test": "ng test",
    "serve:prod": "echo 'Use serve:prod:mainnet or serve:prod:sepolia'",
    "serve:prod:mainnet": "http-server-spa dist/etherphunks-market-mainnet_* index.html 4200 --cors --ssl --cert ssl/cert.pem --key ssl/key.pem --open",
    "serve:prod:sepolia": "http-server-spa dist/etherphunks-market-sepolia_* index.html 4200 --cors --ssl --cert ssl/cert.pem --key ssl/key.pem --open",
    "serve:prod:mainnet:http": "http-server-spa dist/etherphunks-market-mainnet_* index.html 4200 --cors --open",
    "serve:prod:sepolia:http": "http-server-spa dist/etherphunks-market-sepolia_* index.html 4200 --cors --open",
    "run-built": "http-server-spa dist/etherphunks-market index.html 8000",
    "translate": "ng extract-i18n --output-path src/locale",
    "translate:json": "ng extract-i18n --output-path src/locale --format=json",
    "deploy:ipfs:sepolia": "node deploy-ipfs.js --configuration=sepolia",
    "deploy:ipfs:mainnet": "node deploy-ipfs.js --configuration=mainnet",
    "deploy:ipfs": "yarn deploy:ipfs:mainnet && yarn deploy:ipfs:sepolia"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.9",
    "@angular/common": "19.2.9",
    "@angular/compiler": "19.2.9",
    "@angular/core": "19.2.9",
    "@angular/forms": "19.2.9",
    "@angular/platform-browser": "19.2.9",
    "@angular/platform-browser-dynamic": "19.2.9",
    "@angular/router": "19.2.9",
    "@angular/service-worker": "19.2.9",
    "@apollo/client": "^3.13.8",
    "@ng-select/ng-select": "^14.7.0",
    "@ng-web-apis/common": "^4.12.0",
    "@ng-web-apis/intersection-observer": "^4.12.0",
    "@ngrx/effects": "^19.1.0",
    "@ngrx/operators": "^19.1.0",
    "@ngrx/router-store": "^19.1.0",
    "@ngrx/store": "^19.1.0",
    "@ngrx/store-devtools": "^19.1.0",
    "@supabase/supabase-js": "^2.47.16",
    "@wagmi/connectors": "^5.8.1",
    "@wagmi/core": "^2.17.1",
    "@web3modal/wagmi": "^5.1.11",
    "@xmtp/browser-sdk": "^4.0.2",
    "animejs": "^3.2.1",
    "apollo-angular": "^10.0.3",
    "dotenv": "^16.4.5",
    "get-pixels": "^3.3.3",
    "gsap": "^3.12.7",
    "ipfs-http-client": "56.0.1",
    "localforage": "^1.10.0",
    "marked": "^15.0.12",
    "moment": "^2.30.1",
    "ng-lazyload-image": "^9.1.3",
    "ngx-pagination": "^6.0.3",
    "ngx-socket-io": "4.8.5",
    "ngx-timeago": "^3.0.0",
    "ngxtension": "^5.0.0",
    "react": "^19.1.0",
    "rxjs": "^7.4.0",
    "svgson": "^5.3.1",
    "tinycolor2": "^1.6.0",
    "tippy.js": "^6.3.7",
    "tslib": "^2.1.0",
    "upng-js": "^2.1.0",
    "uri-js": "^4.4.1",
    "uuid": "^9.0.1",
    "viem": "^2.31.7",
    "webpack": "^5.47.1",
    "zone.js": "~0.15.0"
  },
  "resolutions": {
    "@noble/hashes": "^1.8.0",
    "@noble/curves": "^1.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.16.1",
    "@angular-builders/custom-esbuild": "^19.1.0",
    "@angular-devkit/build-angular": "^19.2.10",
    "@angular/build": "19.2.10",
    "@angular/cli": "19.2.10",
    "@angular/compiler-cli": "19.2.9",
    "@angular/localize": "19.2.9",
    "@types/animejs": "^3.1.10",
    "@types/get-pixels": "^3.3.4",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
