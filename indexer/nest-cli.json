{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "_static/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  },
  "projects": {
    "sepolia": {
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.sepolia.json",
        "assets": [
          {
            "include": "_static/**/*",
            "outDir": "dist/sepolia/src",
            "watchAssets": true
          }
        ]
      }
    },
    "mainnet": {
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.mainnet.json",
        "assets": [
          {
            "include": "_static/**/*",
            "outDir": "dist/mainnet/src",
            "watchAssets": true
          }
        ]
      }
    }
  }
}
